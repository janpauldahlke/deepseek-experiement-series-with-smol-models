{
  "name": "dsh-agent-pet",
  "description": "DeepSeek Harness Web Client plugin: a Kirby-like companion blob on shell.overlay whose moods react to agent activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/three": "^0.185.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.8.3"
  }
}
